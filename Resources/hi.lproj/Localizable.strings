"menu.help" = "सहायता";
"help.title" = "Tatami सहायता";
"help.intro" = "Tatami आपकी विंडो को ग्रिड पर व्यवस्थित करता है। इसे ऐसे इस्तेमाल करें।";
"help.grid.title" = "ग्रिड दिखाएँ";
"help.grid.body" = "मेनू बार आइकन से “ग्रिड दिखाएँ” चुनें, या उसका शॉर्टकट दबाएँ। क्षेत्र चुनने के लिए खानों पर खींचें — छोड़ते ही मौजूदा विंडो वहाँ चली जाएगी। रद्द करने के लिए Esc दबाएँ या बाहर क्लिक करें।";
"help.snap.title" = "स्क्रीन के किनारे पर खींचें";
"help.snap.body" = "विंडो को उसके टाइटल बार से पकड़कर स्क्रीन के ऊपर खींचें तो वह अधिकतम हो जाएगी, बाएँ या दाएँ किनारे पर खींचें तो आधी स्क्रीन भरेगी। खींचते समय पूर्वावलोकन दिखता है। अगर macOS की अपनी टाइलिंग भी काम करने लगे, तो सिस्टम सेटिंग्स → डेस्कटॉप और डॉक में उसे बंद करें।";
"help.shortcuts.title" = "शॉर्टकट";
"help.shortcuts.body" = "सेटिंग्स → विंडो व्यवस्था में शॉर्टकट जोड़ें, छोटे ग्रिड पर उसका क्षेत्र चुनें, नाम दें और कुंजी संयोजन रिकॉर्ड करें। किसी भी ऐप में उसे दबाने पर मौजूदा विंडो वहाँ चली जाएगी। फ़ंक्शन शॉर्टकट से ग्रिड खोल सकते हैं या विंडो को अगली स्क्रीन पर ले जा सकते हैं।";
"help.screens.title" = "कई स्क्रीन";
"help.screens.body" = "ग्रिड हर स्क्रीन पर दिखता है — जिस स्क्रीन पर विंडो चाहिए, वहीं चुनें। किनारे पर खींचने पर पॉइंटर वाली स्क्रीन इस्तेमाल होती है। “अगली स्क्रीन पर ले जाएँ” विंडो की सापेक्ष स्थिति बनाए रखता है।";
"help.permission.title" = "एक्सेसिबिलिटी अनुमति";
"help.permission.body" = "दूसरे ऐप की विंडो हिलाने के लिए Tatami को एक्सेसिबिलिटी अनुमति चाहिए। अगर विंडो नहीं हिलती, तो मेनू में अनुमति की स्थिति देखें और सिस्टम सेटिंग्स → गोपनीयता और सुरक्षा → एक्सेसिबिलिटी में Tatami चालू करें।";

"menu.about" = "Tatami के बारे में";
"about.credits" = "विंडो को ग्रिड पर व्यवस्थित करें।\nMIT लाइसेंस के तहत ओपन सोर्स।";
