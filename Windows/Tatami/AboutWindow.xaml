<Window x:Class="Tatami.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tatami"
        SizeToContent="Height" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="{Binding [menu.about], Source={x:Static local:Loc.Instance}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static local:Loc.Instance}}"
        Language="{Binding XmlLanguage, Source={x:Static local:Loc.Instance}}">
    <StackPanel Margin="24,20,24,24" HorizontalAlignment="Center">
        <Image x:Name="AppIconImage" Width="96" Height="96" HorizontalAlignment="Center" />
        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Tatami" />
        <TextBlock x:Name="VersionText" Margin="0,2,0,0" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <!-- 簡介 + 可以點的連結（專案網址、贊助），置中顯示 -->
        <TextBlock Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding [about.credits], Source={x:Static local:Loc.Instance}}" />
        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="12">
            <Hyperlink NavigateUri="https://github.com/lenny-osp/tatami" RequestNavigate="OnRequestNavigate">GitHub</Hyperlink>
            <Run Text="  ·  " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Hyperlink NavigateUri="https://www.buymeacoffee.com/chihlingw" RequestNavigate="OnRequestNavigate">Buy Me a Coffee</Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="11"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Copyright © 2026 Chihling Wang &lt;chihlingw@gmail.com&gt;" />
    </StackPanel>
</Window>
