<Window x:Class="Tatami.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tatami"
        xmlns:core="clr-namespace:Tatami.Core"
        Width="560" Height="720" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection, Source={x:Static local:Loc.Instance}}"
        Language="{Binding XmlLanguage, Source={x:Static local:Loc.Instance}}">
    <TabControl x:Name="Tabs" Margin="12,8,12,12" SelectionChanged="OnTabChanged">

        <!-- 一般 -->
        <TabItem Header="{Binding [tab.general], Source={x:Static local:Loc.Instance}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,12,8,12">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding [general.language], Source={x:Static local:Loc.Instance}}" />
                                <ComboBox Grid.Column="1" MinWidth="160"
                                          ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding Language}"
                                          DisplayMemberPath="NativeName" />
                            </Grid>
                            <CheckBox Margin="0,12,0,0"
                                      IsChecked="{Binding IsLaunchAtLoginEnabled}"
                                      Content="{Binding [general.launchAtLogin], Source={x:Static local:Loc.Instance}}" />
                            <CheckBox Margin="0,12,0,0" IsChecked="{Binding IsAutoUpdateEnabled}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [general.autoUpdate], Source={x:Static local:Loc.Instance}}" />
                                    <TextBlock Style="{StaticResource Secondary}"
                                               Text="{Binding [general.autoUpdate.subtitle], Source={x:Static local:Loc.Instance}}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="{Binding [general.backup.header], Source={x:Static local:Loc.Instance}}" />
                    <Border Style="{StaticResource Card}">
                        <WrapPanel>
                            <Button Margin="0,0,8,0" Click="OnExportClick"
                                    Content="{Binding [general.export], Source={x:Static local:Loc.Instance}}" />
                            <Button Click="OnImportClick"
                                    Content="{Binding [general.import], Source={x:Static local:Loc.Instance}}" />
                        </WrapPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Footer}"
                               Text="{Binding [general.backup.footer], Source={x:Static local:Loc.Instance}}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 視窗排列 -->
        <TabItem Header="{Binding [tab.arrangement], Source={x:Static local:Loc.Instance}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,12,8,12">
                    <Border Style="{StaticResource Card}">
                        <CheckBox IsChecked="{Binding IsSnapEnabled}">
                            <StackPanel>
                                <TextBlock Text="{Binding [snap.title], Source={x:Static local:Loc.Instance}}" />
                                <TextBlock Style="{StaticResource Secondary}"
                                           Text="{Binding [snap.subtitle], Source={x:Static local:Loc.Instance}}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- 格線 -->
                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="{Binding [grid.header], Source={x:Static local:Loc.Instance}}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding [grid.columns], Source={x:Static local:Loc.Instance}}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Width="36" Click="OnColumnsDown" Content="−" />
                                    <TextBlock Width="36" TextAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding GridColumns}" />
                                    <Button Width="36" Click="OnColumnsUp" Content="+" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding [grid.rows], Source={x:Static local:Loc.Instance}}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Width="36" Click="OnRowsDown" Content="−" />
                                    <TextBlock Width="36" TextAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding GridRows}" />
                                    <Button Width="36" Click="OnRowsUp" Content="+" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Footer}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocFormat}">
                                <Binding Path="[grid.footer]" Source="{x:Static local:Loc.Instance}" />
                                <Binding Path="GridColumns" />
                                <Binding Path="GridRows" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- 功能快捷鍵 -->
                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="{Binding [fixed.header], Source={x:Static local:Loc.Instance}}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [fixed.showGrid], Source={x:Static local:Loc.Instance}}" />
                                    <TextBlock Style="{StaticResource Warning}"
                                               Visibility="{Binding IsShowGridConflicting, Converter={StaticResource BoolToVisibility}}"
                                               Text="{Binding [shortcut.conflict], Source={x:Static local:Loc.Instance}}" />
                                </StackPanel>
                                <local:ShortcutRecorder Grid.Column="1" KeyCombo="{Binding ShowGridKeyCombo}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [fixed.nextScreen], Source={x:Static local:Loc.Instance}}" />
                                    <TextBlock Style="{StaticResource Warning}"
                                               Visibility="{Binding IsNextScreenConflicting, Converter={StaticResource BoolToVisibility}}"
                                               Text="{Binding [shortcut.conflict], Source={x:Static local:Loc.Instance}}" />
                                </StackPanel>
                                <local:ShortcutRecorder Grid.Column="1" KeyCombo="{Binding NextScreenKeyCombo}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Footer}"
                               Text="{Binding [fixed.footer], Source={x:Static local:Loc.Instance}}" />

                    <!-- 自訂快捷鍵 -->
                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="{Binding [shortcuts.header], Source={x:Static local:Loc.Instance}}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Shortcuts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:WindowShortcut}">
                                        <Grid Margin="0,4,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 左邊挑區塊 -->
                                            <local:GridPicker VerticalAlignment="Top"
                                                              CellBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                              Grid="{Binding Grid}"
                                                              Selection="{Binding Selection}" />
                                            <!-- 右邊填名稱、錄快捷鍵 -->
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                <Grid>
                                                    <TextBox x:Name="NameBox"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                               Style="{StaticResource Secondary}"
                                                               Text="{Binding [shortcut.namePlaceholder], Source={x:Static local:Loc.Instance}}">
                                                        <TextBlock.Visibility>
                                                            <Binding Path="Text" ElementName="NameBox">
                                                                <Binding.Converter>
                                                                    <local:EmptyToVisibleConverter />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </TextBlock.Visibility>
                                                    </TextBlock>
                                                </Grid>
                                                <local:ShortcutRecorder Margin="0,6,0,0" HorizontalAlignment="Left"
                                                                        KeyCombo="{Binding KeyCombo}" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Warning}"
                                                           Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}"
                                                           Text="{Binding [shortcut.conflict], Source={x:Static local:Loc.Instance}}" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Secondary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource LocFormat}">
                                                            <Binding Path="[shortcut.gridSize]" Source="{x:Static local:Loc.Instance}" />
                                                            <Binding Path="Grid.Columns" />
                                                            <Binding Path="Grid.Rows" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" VerticalAlignment="Top" Padding="8"
                                                    Background="Transparent" BorderThickness="0"
                                                    Click="OnDeleteShortcutClick"
                                                    ToolTip="{Binding [shortcut.delete], Source={x:Static local:Loc.Instance}}">
                                                <TextBlock FontFamily="{StaticResource SymbolFont}" Text="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Left" Click="OnAddShortcutClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource SymbolFont}" Text="&#xE710;"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding [shortcuts.add], Source={x:Static local:Loc.Instance}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Footer}"
                               Text="{Binding [shortcuts.footer], Source={x:Static local:Loc.Instance}}" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
